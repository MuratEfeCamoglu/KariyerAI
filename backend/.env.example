# Kopyala: copy .env.example .env   (macOS/Linux: cp .env.example .env)
DATABASE_URL=sqlite:///./data/kariyerai.db

# En az 32 karakter. Yerel geliştirme dışında mutlaka rastgele bir değerle değiştir.
JWT_SECRET=dev-only-change-me-0123456789abcdef

# fake: API anahtarı gerekmez, deterministik çıktı (testler her zaman fake kullanır)
# anthropic: gerçek Claude API, ANTHROPIC_API_KEY gerekir
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

UPLOAD_DIR=./data/uploads
