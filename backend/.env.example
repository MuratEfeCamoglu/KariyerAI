# Kopyala: copy .env.example .env   (macOS/Linux: cp .env.example .env)
DATABASE_URL=sqlite:///./data/kariyerai.db

# En az 32 karakter. Yerel geliştirme dışında mutlaka rastgele bir değerle değiştir.
JWT_SECRET=dev-only-change-me-0123456789abcdef

# fake: API anahtarı gerekmez, deterministik çıktı (testler her zaman fake kullanır)
# anthropic: gerçek Claude API, ANTHROPIC_API_KEY gerekir
# gemini / groq: ücretsiz katmanlar (GEMINI_API_KEY / GROQ_API_KEY) — YALNIZCA sentetik/test CV'leriyle kullanın
#         (ücretsiz katmanda gönderilen içerik sağlayıcının ürün geliştirmesinde kullanılabilir; KVKK)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

UPLOAD_DIR=./data/uploads

# Canlıda (HTTPS arkasında) true yapın: oturum cookie'si yalnızca HTTPS ile gönderilir.
# true iken yukarıdaki örnek JWT_SECRET ile uygulama başlamaz.
COOKIE_SECURE=false
