# Kopyala: copy .env.example .env   (macOS/Linux: cp .env.example .env)
DATABASE_URL=sqlite:///./data/kariyerai.db

# En az 32 karakter. Yerel geliştirme dışında mutlaka rastgele bir değerle değiştir.
JWT_SECRET=dev-only-change-me-0123456789abcdef

# groq:   Groq API (console.groq.com), GROQ_API_KEY gerekir — önerilen
# gemini: Google Gemini API (aistudio.google.com), GEMINI_API_KEY gerekir
# gemini,groq: öncelik sırasıyla dener; Gemini kotası dolunca Groq kullanılır (iki anahtar da gerekir)
# fake:   API anahtarı gerekmez, deterministik test çıktısı (testler her zaman fake kullanır)
# KVKK: Gerçek aday CV'leri seçilen sağlayıcıya (yurt dışı) gönderilir. Ücretsiz katmanların veri
# koşullarını ve hukuk onayını README "LLM sağlayıcısı" bölümünden kontrol edin.
LLM_PROVIDER=fake
# İsteğe bağlı: ayrıştırma ve puanlama için ayrı zincir (boşsa LLM_PROVIDER). Gemini kotasını uzatır:
# LLM_PARSE_PROVIDER=groq,gemini
# LLM_SCORE_PROVIDER=gemini,groq
LLM_PARSE_PROVIDER=
LLM_SCORE_PROVIDER=
GEMINI_API_KEY=
# Virgülle sıralı liste olabilir; ücretsiz kota model başınadır (ör. gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

UPLOAD_DIR=./data/uploads

# Canlıda (HTTPS arkasında) true yapın: oturum cookie'si yalnızca HTTPS ile gönderilir.
# true iken yukarıdaki örnek JWT_SECRET ile uygulama başlamaz.
COOKIE_SECURE=false
